{
  "name": "lltv-playout-v1",
  "version": "1.5.0",
  "private": true,
  "description": "LLTV Brasil broadcast playout platform - integrated broadcast modules",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "nodemon backend/src/server.js",
    "test": "node --test",
    "db:migrate": "node backend/src/db/migrate.js",
    "scheduler:run-once": "node scripts/run-scheduler-once.js",
    "media:check": "node scripts/check-ffmpeg.js",
    "doctor": "node scripts/doctor.js",
    "install:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-lltv-windows.ps1",
    "backup:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-lltv.ps1"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "ws": "^8.18.0",
    "zod": "^3.24.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
